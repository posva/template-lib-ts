{
  "name": "template-lib-ts",
  "version": "0.0.0",
  "description": "Modern, ai-ready TypeScript library template",
  "keywords": [
    "your keywords here"
  ],
  "homepage": "https://github.com/posva/template-lib-ts",
  "bugs": {
    "url": "https://github.com/posva/template-lib-ts/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Eduardo San Martin Morote",
    "email": "posva13@gmail.com"
  },
  "repository": "posva/template-lib-ts",
  "funding": "https://github.com/sponsors/posva",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest --ui",
    "test": "pnpm run build && pnpm run test:cov && pnpm run test:types",
    "test:cov": "vitest run --coverage",
    "test:types": "tsc --build ./tsconfig.json",
    "lint": "oxlint ${CI:+--deny-warnings} .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "prepare": "simple-git-hooks",
    "release": "node scripts/release.ts",
    "prepublishOnly": "pnpm run build",
    "size": "size-limit"
  },
  "devDependencies": {
    "@posva/prompts": "^2.4.4",
    "@size-limit/esbuild-why": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^26.0.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "happy-dom": "^20.10.6",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-plugin-posva": "^0.0.2",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.1.0",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.38"
  },
  "peerDependencies": {
    "vue": "^3.5.17"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verifyCommit.js"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern --fix"
    ]
  },
  "size-limit": [
    {
      "name": "everything from source",
      "path": "src/index.ts",
      "import": "*",
      "ignore": [
        "vue"
      ]
    },
    {
      "name": "everything from dist",
      "path": "dist/index.mjs",
      "import": "*",
      "ignore": [
        "vue"
      ]
    }
  ],
  "packageManager": "pnpm@11.8.0"
}
